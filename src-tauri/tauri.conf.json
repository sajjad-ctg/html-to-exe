{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "html-to-exe",
  "version": "0.2.0",
  "identifier": "com.mskctg.htmltoexe",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "html-to-exe",
        "width": 680,
        "height": 560,
        "minWidth": 560,
        "minHeight": 460,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
